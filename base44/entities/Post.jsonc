{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Content"
    },
    "image_url": {
      "type": "string",
      "title": "Image Url"
    },
    "author_id": {
      "type": "string",
      "title": "Author Id"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "author_avatar": {
      "type": "string",
      "title": "Author Avatar"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "title": "Likes"
    },
    "event_id": {
      "type": "string",
      "title": "Event Id"
    },
    "music_url": {
      "type": "string",
      "title": "Music Url"
    },
    "music_title": {
      "type": "string",
      "title": "Music Title"
    },
    "music_artist": {
      "type": "string",
      "title": "Music Artist"
    },
    "music_artwork": {
      "type": "string",
      "title": "Music Artwork"
    },
    "is_example": {
      "type": "boolean",
      "default": false,
      "title": "Is Example"
    }
  },
  "required": [
    "content",
    "author_id",
    "author_name"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}