{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "body": {
      "type": "string",
      "title": "Body"
    },
    "category": {
      "type": "string",
      "enum": [
        "launch",
        "update",
        "maintenance",
        "general"
      ],
      "default": "general",
      "title": "Category"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "title": "Pinned"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    }
  },
  "required": [
    "title",
    "body"
  ]
}