{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "title": "Event Id"
    },
    "user_id": {
      "type": "string",
      "title": "User Id"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "user_avatar": {
      "type": "string",
      "title": "User Avatar"
    },
    "user_city": {
      "type": "string",
      "title": "User City"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "interested"
      ],
      "default": "confirmed",
      "title": "Status"
    }
  },
  "required": [
    "event_id",
    "user_id"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}