{
  "name": "ProfilePhoto",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User Id"
    },
    "url": {
      "type": "string",
      "title": "Url"
    },
    "album": {
      "type": "string",
      "enum": [
        "profile",
        "cover",
        "gallery"
      ],
      "default": "gallery",
      "title": "Album"
    }
  },
  "required": [
    "user_id",
    "url"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}