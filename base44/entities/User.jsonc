{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar Url"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover Url"
    },
    "background_photo": {
      "type": "string",
      "title": "Background Photo"
    },
    "public_profile": {
      "type": "boolean",
      "default": true,
      "title": "Public Profile"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "none",
        "artist",
        "content_creator"
      ],
      "default": "none",
      "title": "Profile Type"
    },
    "selfie_verified": {
      "type": "boolean",
      "default": false,
      "title": "Selfie Verified"
    },
    "selfie_uri": {
      "type": "string",
      "title": "Selfie Uri"
    },
    "id_submitted": {
      "type": "boolean",
      "default": false,
      "title": "Id Submitted"
    },
    "id_uri": {
      "type": "string",
      "title": "Id Uri"
    },
    "id_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Id Expires At"
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Traits"
    },
    "hobbies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hobbies"
    },
    "music": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Music"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Interests"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Goals"
    },
    "professional_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Professional Interests"
    },
    "family_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Family Members"
    },
    "job": {
      "type": "string",
      "title": "Job"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "birthday": {
      "type": "string",
      "title": "Birthday"
    },
    "status_emoji": {
      "type": "string",
      "default": "\ud83d\udc51",
      "title": "Status Emoji"
    },
    "show_online": {
      "type": "boolean",
      "default": true,
      "title": "Show Online"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "title": "Last Seen"
    }
  },
  "required": [
    "role"
  ]
}