{
  "name": "Klout",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "profile",
        "event",
        "click",
        "post",
        "comment",
        "photo",
        "video"
      ],
      "default": "profile",
      "title": "Target Type"
    },
    "target_id": {
      "type": "string",
      "title": "Target Id"
    },
    "user_id": {
      "type": "string",
      "title": "User Id"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "user_avatar": {
      "type": "string",
      "title": "User Avatar"
    },
    "reaction": {
      "type": "string",
      "enum": [
        "thumbs",
        "horns",
        "crown"
      ],
      "default": "thumbs",
      "title": "Reaction"
    },
    "value": {
      "type": "number",
      "default": 1,
      "title": "Value"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "user_id",
    "reaction"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}