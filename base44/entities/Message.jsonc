{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "title": "Conversation Id"
    },
    "sender_id": {
      "type": "string",
      "title": "Sender Id"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender Name"
    },
    "sender_avatar": {
      "type": "string",
      "title": "Sender Avatar"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "image_url": {
      "type": "string",
      "title": "Image Url"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Member Ids"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "Read"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.member_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}