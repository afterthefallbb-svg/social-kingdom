      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "age": {
      "type": "number",
      "title": "Age"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Interests"
    },
