{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "title": "Reporter Id"
    },
    "reporter_name": {
      "type": "string",
      "title": "Reporter Name"
    },
    "reporter_email": {
      "type": "string",
      "title": "Reporter Email"
    },
    "target_user_id": {
      "type": "string",
      "title": "Target User Id"
    },
    "target_user_name": {
      "type": "string",
      "title": "Target User Name"
    },
    "conversation_id": {
      "type": "string",
      "title": "Conversation Id"
    },
    "category": {
      "type": "string",
      "enum": [
        "spam",
        "abuse",
        "other"
      ],
      "default": "spam",
      "title": "Category",
      "enumColors": [
        "yellow",
        "red",
        "gray"
      ]
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed"
      ],
      "default": "new",
      "title": "Status",
      "enumColors": [
        "blue",
        "green"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "reporter_id",
    "target_user_id",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}