{
  "name": "Click",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar Url"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "member_count": {
      "type": "number",
      "default": 0,
      "title": "Member Count"
    },
    "show_online": {
      "type": "boolean",
      "default": true,
      "title": "Show Online"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}