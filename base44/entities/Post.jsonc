{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Content"
    },
    "image_url": {
      "type": "string",
      "title": "Image Url"
    },
    "author_id": {
      "type": "string",
      "title": "Author Id"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "author_avatar": {
      "type": "string",
      "title": "Author Avatar"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "title": "Likes"
    },
    "event_id": {
      "type": "string",
      "title": "Event Id"
    },
    "music_url": {
      "type": "string",
      "title": "Music Url"
    },
    "music_title": {
      "type": "string",
      "title": "Music Title"
    },
    "music_artist": {
      "type": "string",
      "title": "Music Artist"
    },
    "music_artwork": {
      "type": "string",
      "title": "Music Artwork"
    }
  },
  "required": [
    "content",
    "author_id",
    "author_name"
  ]
}