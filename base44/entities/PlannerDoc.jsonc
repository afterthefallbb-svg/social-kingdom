{
  "name": "PlannerDoc",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User Id"
    },
    "key": {
      "type": "string",
      "title": "Key"
    },
    "data": {
      "type": "object",
      "title": "Data"
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "user_id",
    "key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}